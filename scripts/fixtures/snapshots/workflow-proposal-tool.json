{
  "name": "agent_teams_workflow_propose",
  "description": "Save a proposal for human preview. Does not apply changes or approve checkpoints.",
  "parameters": {
    "type": "object",
    "properties": {
      "base": {
        "type": "string",
        "description": "Copy base exactly from the latest agent_teams_workflow_context result."
      },
      "title": {
        "type": "string"
      },
      "operations": {
        "type": "array",
        "description": "One atomic batch of 1–50 proposed edits. Submit objects directly, not a JSON-encoded string. No changes take effect before human confirmation.",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "add_member",
                "update_member",
                "remove_member",
                "add_task",
                "update_task",
                "remove_task",
                "rerun_task",
                "rework"
              ]
            },
            "id": {
              "type": "string",
              "description": "Existing task ID for task edits/removal/rerun, or checkpoint ID for rework. Optional new ID for add_task."
            },
            "name": {
              "type": "string",
              "description": "Required for member operations; use the exact member name."
            },
            "subject": {
              "type": "string",
              "description": "Required non-empty title for add_task."
            },
            "summary": {
              "type": "string",
              "description": "Required responsibility summary for add_member."
            },
            "role": {
              "type": "string"
            },
            "executionPrompt": {
              "type": "string"
            },
            "specificPrompt": {
              "type": "string"
            },
            "provider": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "reasoningEffort": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "assignee": {
              "type": "string"
            },
            "adaptationIssue": {
              "type": "string"
            },
            "instructions": {
              "type": "string",
              "description": "Required non-empty new requirements for rerun_task and rework."
            },
            "dependencies": {
              "type": "array",
              "description": "Required for add_task; use [] for no prerequisites. For update_task omit to keep existing dependencies.",
              "items": {
                "type": "string"
              }
            },
            "taskIds": {
              "type": "array",
              "description": "Required upstream task IDs for rework.",
              "items": {
                "type": "string"
              }
            },
            "checkpoint": {
              "type": "boolean"
            },
            "configurationPending": {
              "type": "boolean"
            },
            "confirmConfiguration": {
              "type": "boolean"
            }
          },
          "required": [
            "action"
          ]
        }
      }
    },
    "required": [
      "base",
      "title",
      "operations"
    ]
  }
}
